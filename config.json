  "profile": {
    "who": "中国高中生，知识体系和世界观正在形成。要读经济、政治、科技、社会学的深度内容，不要按中学生水平迁就他，也不要幼稚化。",
    "questions": [
      "技术进步如何改变社会？",
      "生产力发展如何影响人的需求和生活？",
      "经济增长了，为什么普通人的生活感受没有同步改善？",
      "为什么有些产业飞速发展，另一些却在衰退？",
      "国家、制度和社会结构如何影响个人？",
      "人工智能将如何改变就业、教育和权力结构？",
      "科学技术的发展是否必然带来社会进步？"
    ],
    "interests": [
      "AI 模型能力跃升与技术路线变化、Agent、机器人、具身智能",
      "AI 算力、芯片、半导体与产业链、商业化与真实生产力",
      "宏观经济、金融、房地产与地方财政、就业与通胀、贸易与关税",
      "中美中欧关系、美国政治、大国竞争、产业链重构、能源安全",
      "人口与老龄化、城市化、教育、阶层与流动、劳动、技术对人的影响",
      "历史与思想史、政治制度、公共治理、国家与个人",
      "汽车设计工程、电动化、智能驾驶、产业格局、中国车企全球竞争力",
      "物理数学医药天文材料等前沿研究的真实突破",
      "Apple/NVIDIA/Tesla/OpenAI/Google/微软/DeepSeek 等公司的战略与成败原因"
    ],
    "taste": "要事实、逻辑和机制解释；喜欢「数据背后发生了什么」；不满足于只报道一个数字；要看到不同立场与争议；不煽情、不迎合、不把推测当事实。",
    "avoid": [
      "地方性偶发社会新闻",
      "普通产品发布与功能更新",
      "企业日常动态与公关稿",
      "会议、活动、仪式、讲话",
      "娱乐八卦与名人日常",
      "情绪化煽动内容",
      "标题党与低质量营销稿",
      "重复报道",
      "猎奇新闻",
      "缺乏可靠来源的消息"
    ],
    "diversity": "每周最多保留 2 条他兴趣之外、但有解释力的内容；没有就不凑。"
  },
  "images": {
    "enabled": false,
